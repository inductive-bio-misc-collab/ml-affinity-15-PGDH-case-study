.venv/
__pycache__/
*.pyc

# Regenerated by scoring/run_boltz.py. boltz_predictions.csv is checked in
# as a pre-computed artifact so the analysis runs without re-running Boltz,
# along with the top-ranked pose per compound (model_0.pdb), which
# boltz_rmsd.py and export_aligned_poses.py read. The bulky intermediate
# YAMLs and the remaining Boltz outputs are not tracked.
scoring/boltz_yamls/
scoring/boltz_results_boltz_yamls/*
!scoring/boltz_results_boltz_yamls/predictions/
scoring/boltz_results_boltz_yamls/predictions/*
!scoring/boltz_results_boltz_yamls/predictions/*/
scoring/boltz_results_boltz_yamls/predictions/*/*
!scoring/boltz_results_boltz_yamls/predictions/*/*_model_0.pdb

# Regenerated by analysis/make_figures.py and analysis/make_stats.py
figures/*.png
figures/*.csv
